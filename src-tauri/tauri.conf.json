{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaFinder",
  "version": "1.0.6",
  "identifier": "com.mediafinder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaFinder",
        "width": 900,
        "height": 620,
        "minWidth": 560,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' thumb: http://thumb.localhost media: http://media.localhost data: blob:; media-src 'self' media: http://media.localhost blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5N0M1Q0ZGOURDMDY2QTAKUldTZ1pzQ2QvMXg4S1Z1TkdjUlNXVDR5N1E0MEgwdFVJRHpraS9lcEVuZGpzVFlEeXo5WXdMRDYK",
      "endpoints": [
        "https://github.com/khanhhoang050120-lang/mediafinder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "MediaFinder",
    "copyright": "© 2026 MediaFinder",
    "shortDescription": "Tìm video, ảnh, nhạc trong máy — tức thì",
    "longDescription": "MediaFinder đọc thẳng bảng tệp của NTFS nên tìm ra kết quả trong vài mili giây thay vì duyệt từng thư mục. Có thumbnail, xem trước ngay trong ứng dụng, lọc theo độ phân giải và thời lượng, tìm tệp trùng, và kéo thả thẳng vào CapCut hay ô upload.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  }
}
